@model TrackListViewModel
@{
    ViewData["Title"] = "Топ класация";
}
<div class="section-head">
    <h2><i class="bi bi-fire text-accent"></i> Топ песни в момента</h2>
    <span class="text-muted small">Източник: Deezer</span>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-warning">@Model.Error</div>
}
<div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-6 g-3">
    @foreach (var t in Model.Tracks)
    {
        <div class="col">
            <partial name="_TrackCard" model="t" view-data='new ViewDataDictionary(ViewData) { { "ShowAdd", true } }' />
        </div>
    }
</div>
