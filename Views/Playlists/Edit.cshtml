@model PlaylistForm
@{
    ViewData["Title"] = "Редакция на плейлист";
    var id = (int)ViewData["PlaylistId"]!;
}
<div class="section-head">
    <h2><i class="bi bi-pencil-fill text-accent"></i> Редакция на плейлист</h2>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <form asp-action="Edit" asp-route-id="@id" method="post" class="panel">
            <partial name="_PlaylistForm" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-accent"><i class="bi bi-check-lg"></i> Запази</button>
                <a class="btn btn-ghost" asp-action="Details" asp-route-id="@id">Отказ</a>
            </div>
        </form>
    </div>
</div>
