@model List<PlaylistSummary>
@{
    ViewData["Title"] = "Плейлисти";
}
<div class="section-head">
    <h2><i class="bi bi-collection-play-fill text-accent"></i> Моите плейлисти</h2>
    <span class="badge badge-soft">@Model.Count</span>
    <a class="btn btn-accent ms-auto" asp-action="Create"><i class="bi bi-plus-lg"></i> Нов плейлист</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-collection-play"></i>
        <p>Все още нямате плейлисти.</p>
        <a class="btn btn-accent" asp-action="Create"><i class="bi bi-plus-lg"></i> Създай първия</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
        @foreach (var p in Model)
        {
            <div class="col"><partial name="_PlaylistCard" model="p" /></div>
        }
    </div>
}
