@model List<FavoriteTrack>
@{
    ViewData["Title"] = "Любими";
}
<div class="section-head">
    <h2><i class="bi bi-heart-fill text-accent"></i> Любими песни</h2>
    <span class="badge badge-soft">@Model.Count</span>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-heart"></i>
        <p>Все още нямате любими песни.</p>
        <a class="btn btn-accent" asp-action="Search">Потърси музика</a>
    </div>
}
else
{
    <div class="panel p-0 table-responsive">
        <table class="table table-borderless align-middle mb-0 fav-table">
            <thead><tr><th style="width:72px"></th><th>Песен</th><th>Албум</th><th>Добавена</th><th></th></tr></thead>
            <tbody>
            @foreach (var f in Model)
            {
                <tr>
                    <td>
                        <div class="cover-wrap cover-sm">
                            @if (!string.IsNullOrEmpty(f.CoverUrl)) { <img src="@f.CoverUrl" alt="" loading="lazy" /> }
                            @if (!string.IsNullOrEmpty(f.PreviewUrl))
                            {
                                <button type="button" class="play-btn play-overlay" aria-label="Пусни"
                                        data-src="@f.PreviewUrl" data-title="@f.Title"
                                        data-artist="@f.Artist" data-cover="@f.CoverUrl">
                                    <i class="bi bi-play-fill"></i>
                                </button>
                            }
                        </div>
                    </td>
                    <td><div class="fw-semibold">@f.Title</div><div class="text-muted small">@f.Artist</div></td>
                    <td class="text-muted">@f.Album</td>
                    <td class="text-muted small">@f.AddedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-end text-nowrap">
                        <div class="d-inline-flex align-items-center gap-1">
                            <button type="button" class="btn btn-sm btn-ghost add-pl-btn" title="Добави в плейлист" aria-label="Добави в плейлист"
                                    data-id="@f.DeezerId" data-title="@f.Title" data-artist="@f.Artist" data-album="@f.Album"
                                    data-cover="@f.CoverUrl" data-preview="@f.PreviewUrl" data-link="@f.Link">
                                <i class="bi bi-collection-play"></i>
                            </button>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="id" value="@f.Id" />
                                <button class="btn btn-sm btn-ghost-danger" title="Премахни"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
